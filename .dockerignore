# Python cache
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo

# Virtual environments
.venv/
venv/
env/

# Git
.git/
.gitignore
.gitattributes

# Tests (not needed in production image)
tests/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo

# Environment files
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# CI/docs (not needed in image)
.ai/
ci/*.md

# NOTE: alembic/ and alembic.ini are intentionally NOT excluded — migrations run inside the container
